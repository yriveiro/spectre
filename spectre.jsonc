// spectre.jsonc — the models a spectre subagent may be spent on, the names the
// router picks from, and where the word dictionary lives when you have one.
// Read by tools.spectre.routing on every call, and by
// tools.spectre.prose when a dictionary is configured.
//
// Every ref below was read out of the live catalogue (`tools.opencode.models`
// on 2.1.0), not written from memory. Variants are the provider's to name and
// the routing tool rechecks them on every call. `glm-5.3-flash` and
// `deepseek-v4.1-flash` carry three thinking efforts — `low`, `high`, `max` —
// `muse-spark-1.3-contributor` carries five — `minimal`, `low`, `medium`,
// `high`, `xhigh` — and `minimax-m3.1-flash-free` carries five — `low`,
// `medium`, `high`, `xhigh`, `max` — so any other `#variant` on any of them
// is rejected.
//
// Cost is not uniform. `minimax-m3.1-flash-free` costs nothing, and the other
// three cost per token, so the ladder is thinking effort first and cost
// second: the paid families lead every profile, and the free model is the last
// rung, where a second opinion costs nothing.
//
// Every ref sits on `opencode-go`, and it is where the cheap paid tiers live:
// `opencode-go/deepseek-v4-pro` costs 0.66 against Zen's 1.74, and
// `opencode-go/muse-spark-1.3-contributor` costs 0.1 against Zen's plain
// `muse-spark-1.3` at 1.25. Two of the ids do not exist on Zen at all:
// `deepseek-v4.1-flash` is `deepseek-v4.1-flash-free` there, and the
// contributor model is `muse-spark-1.3`.
//
// `dictionary` is optional and points at YOUR copy of ASD-STE100 Issue 9,
// exported to the JSON form documented in tools/FOR_AGENTS.md. It is a path to a
// file you hold, not a word list this repository carries: the standard restricts
// reproduction of its dictionary, and nothing here reproduces it. Without the
// key the lexical half of the standard is simply off, and `tools.spectre.prose`
// reports the structural rules alone. Relative paths resolve against the
// directory holding this file.
//
// Uncomment and point this at your own export. `null` clears a path an earlier
// config file set, and leaving the key out leaves an earlier one standing.
//   "dictionary": "/absolute/path/to/asd-ste100-dictionary.json",
{
  "models": {
    // One paid model, three reasoning levels.
    "glm-low": "opencode-go/glm-5.3-flash#low",
    "glm-high": "opencode-go/glm-5.3-flash#high",
    "glm-max": "opencode-go/glm-5.3-flash#max",

    // The other paid model, three reasoning levels.
    "deepseek-low": "opencode-go/deepseek-v4.1-flash#low",
    "deepseek-high": "opencode-go/deepseek-v4.1-flash#high",
    "deepseek-max": "opencode-go/deepseek-v4.1-flash#max",

    // The contributor model, five reasoning levels.
    "muse-minimal": "opencode-go/muse-spark-1.3-contributor#minimal",
    "muse-low": "opencode-go/muse-spark-1.3-contributor#low",
    "muse-medium": "opencode-go/muse-spark-1.3-contributor#medium",
    "muse-high": "opencode-go/muse-spark-1.3-contributor#high",
    "muse-xhigh": "opencode-go/muse-spark-1.3-contributor#xhigh",

    // The free model, five reasoning levels.
    "minimax-low": "opencode-go/minimax-m3.1-flash-free#low",
    "minimax-medium": "opencode-go/minimax-m3.1-flash-free#medium",
    "minimax-high": "opencode-go/minimax-m3.1-flash-free#high",
    "minimax-xhigh": "opencode-go/minimax-m3.1-flash-free#xhigh",
    "minimax-max": "opencode-go/minimax-m3.1-flash-free#max",
  },

  "profiles": {
    "mechanical": {
      "model": ["glm-low", "deepseek-low"],
      "why": "One command, one log, and a report. Nothing to decide, so the cheapest effort runs it; a wrong answer here shows up as a failed command rather than a wrong commit.",
    },
    "search": {
      "model": ["glm-high", "deepseek-low"],
      "why": "Find where something lives: grep, read, name the call sites. A missed symbol costs a second pass over the repo, so it leads above the floor and escalates to the other model.",
    },
    "worker": {
      "model": ["deepseek-high", "glm-high", "muse-high", "minimax-high"],
      "why": "A change that is already decided and has to be executed across several files. The model holds one plan while editing it, so it takes a high effort rather than the floor. The free model is the last rung, so the cross-check costs nothing.",
    },
    "judgment": {
      "model": ["deepseek-high", "glm-high", "muse-xhigh", "minimax-xhigh"],
      "why": "Two defensible options and one has to be chosen. High effort on one family, the same level on the other as the cross-check, because a wrong call is expensive to undo and a second opinion is the cheapest way to catch one. The free model takes that second opinion.",
    },
    "thinking": {
      "model": ["deepseek-max", "glm-max", "minimax-max"],
      "why": "One hard problem where the answer has to be right and there is no diff to read the answer out of. The escalation goes to another family at its top effort, because a second family beats the same family asked twice.",
    },
    "deep": {
      "model": ["deepseek-max", "glm-max", "minimax-max"],
      "why": "Architecture, a cross-cutting design, or a bug nobody has localized yet. The task that decides everything takes the top effort on every model rather than saving on the work that matters most.",
    },
    "refactor": {
      "model": ["deepseek-high", "glm-max", "minimax-max"],
      "why": "Restructure code that already works, across files, without changing behaviour. It needs thinking plus breadth of reading, so it takes the second-highest effort rather than the top, and keeps the other model's second-highest in reserve for the mechanical part of the move. The free model is the last rung.",
    },
  },
  "dictionary": "/Users/yriveiro/Dump/asd-ste100-dictionary.json",
}
