// spectre.jsonc — the models a spectre subagent may be spent on, the names the
// router picks from, and where the word dictionary lives when you have one.
// Read by tools.spectre.routing on every call, and by
// tools.spectre.prose when a dictionary is configured.
//
// Every ref below was read out of the live catalogue (`tools.opencode.models`
// on 2.0.30), not written from memory. Variants are the provider's to name and
// the routing tool rechecks them on every call. `deepseek-v4.1-flash-free`
// carries three thinking efforts — `low`, `high`, `max` — and `cat-jam-free`
// carries five — `low`, `medium`, `high`, `xhigh`, `max` — so any other
// `#variant` on either is rejected.
//
// `deepseek-v4.1-flash-free` sits on `opencode` (Zen), NOT on `opencode-go`,
// which carries only the paid `deepseek-v4.1-flash`. `cat-jam-free` is free on
// both providers and sits on `opencode` here to match. All refs are free, so
// the ladder is thinking effort rather than cost: the shallow profiles run on
// `flash-*`, the deep ones on `jam-*`.
//
// `dictionary` is optional and points at YOUR copy of ASD-STE100 Issue 9,
// exported to the JSON form documented in tools/FOR_AGENTS.md. It is a path to a
// file you hold, not a word list this repository carries: the standard restricts
// reproduction of its dictionary, and nothing here reproduces it. Without the
// key the lexical half of the standard is simply off, and `tools.spectre.prose`
// reports the structural rules alone. Relative paths resolve against the
// directory holding this file.
//
// Uncomment and point this at your own export. `null` clears a path an earlier
// config file set, and leaving the key out leaves an earlier one standing.
//   "dictionary": "/absolute/path/to/asd-ste100-dictionary.json",
{
  "models": {
    "flash-low": "opencode/deepseek-v4.1-flash-free#low",
    "flash-high": "opencode/deepseek-v4.1-flash-free#high",
    "flash-max": "opencode/deepseek-v4.1-flash-free#max",
    "jam-low": "opencode/cat-jam-free#low",
    "jam-medium": "opencode/cat-jam-free#medium",
    "jam-high": "opencode/cat-jam-free#high",
    "jam-xhigh": "opencode/cat-jam-free#xhigh",
    "jam-max": "opencode/cat-jam-free#max",
  },

  "profiles": {
    "mechanical": {
      "model": "flash-low",
      "why": "One command, one log, one named file. Report what it said and decide nothing.",
    },
    "reading": {
      "model": ["flash-low", "flash-high"],
      "why": "A few files that have to be understood before answering. A diff, a stack trace, a failing test name.",
    },
    "judgement": {
      "model": ["jam-high", "jam-xhigh"],
      "why": "A decision with consequences: which of several designs to take, or why a subsystem breaks.",
    },
    "deep": {
      "model": "jam-max",
      "why": "A whole subsystem, or the word refactor. The strongest thinking available here.",
    },
  },
  "dictionary": "/Users/yriveiro/Dump/asd-ste100-dictionary.json",
}
