{
  "name": "oc-spectre",
  "version": "0.1.0",
  "description": "Spectre, a coding agent built on top of OpenCode",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui/index.tsx"
  },
  "files": [
    "index.ts",
    "tui",
    "spectre.default.json",
    "agents",
    "commands",
    "skills",
    "tools"
  ],
  "engines": {
    "opencode": ">=2.1.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval": "bun run eval/run.ts",
    "eval:routing": "bun run eval/routing/run.ts",
    "anatomy-kit.sync": "sh scripts/sync-anatomy-kit.sh",
    "d3.vendor": "bun run scripts/sync-d3.ts"
  },
  "dependencies": {
    "@opencode/ai": "2.1.1",
    "@opencode/plugin": "2.1.1",
    "@opencode/schema": "2.1.1",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@opencode/theme": "2.1.2",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "solid-js": "1.9.12",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opencode/theme": ">=2.1.1",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.12"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
