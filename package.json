{
  "name": "oc-spectre",
  "version": "0.1.0",
  "description": "Spectre, a coding agent built on top of OpenCode",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "agents",
    "commands",
    "skills",
    "tools"
  ],
  "engines": {
    "opencode": ">=2.0.29"
  },
  "scripts": {
