    "@opencode/schema": "2.2.6",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.2.6",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@types/bun": "1.4.3",
    "@types/node": "24.12.2",
    "solid-js": "1.9.12",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "@opencode/theme": ">=2.2.6",
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.12"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    },
