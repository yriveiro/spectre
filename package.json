{
  "name": "oc-spectre",
  "version": "0.1.0",
  "description": "Spectre, a coding agent built on top of OpenCode",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui/index.tsx"
  },
  "files": [
    "index.ts",
    "tui",
    "spectre.default.json",
    "agents",
    "commands",
    "scripts",
    "skills",
    "tools"
  ],
  "engines": {
    "opencode": ">=2.2.7"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval": "bun run eval/run.ts",
    "eval:resume": "bun run eval/resume/run.ts",
    "eval:routing": "bun run eval/routing/run.ts",
    "d3.check": "bun run scripts/check-d3.ts"
  },
  "dependencies": {
    "@opencode/ai": "2.2.7",
    "@opencode/plugin": "2.2.7",
    "@opencode/schema": "2.2.7",
    "d3": "^7.9.2",
    "pele": "1.13.0"
  },
  "devDependencies": {
    "@opencode/client": "2.2.7",
    "@opencode/theme": "2.2.7",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.2",
    "effect": "4.1.0",
    "solid-js": "1.9.17",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opencode/theme": ">=2.2.7",
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "effect": "^4.0.0",
    "solid-js": ">=1.9.12"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
