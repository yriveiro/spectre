    "d3.vendor": "bun run scripts/sync-d3.ts"
  },
  "dependencies": {
    "@opencode/ai": "2.0.29",
    "@opencode/plugin": "2.0.29",
    "@opencode/schema": "2.0.29",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "typescript": "7.0.2"
  }
}
