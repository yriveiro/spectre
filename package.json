{
  "name": "spectre",
  "version": "0.1.0",
  "description": "Spectre, a coding agent built on top of OpenCode",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui/index.tsx"
  },
